[Unit]
Description=Homelab Dns Compose Stack
Requires=containerd.service
After=containerd.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
TimeoutStopSec=60

WorkingDirectory=/home/shaan/dns

ExecStart=/usr/bin/nerdctl compose up -d --force-recreate
ExecStop=/usr/bin/nerdctl compose stop

[Install]
WantedBy=multi-user.target
